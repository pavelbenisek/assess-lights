#!/bin/sh
# Self-locating launcher for assess-lights.
#
# Resolves its own real path (following symlinks) and execs the virtualenv that
# belongs to this installation, so the command works from any directory and can
# be symlinked onto PATH without hard-coding where the project lives.
set -e

src=$0
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case $src in
    /*) ;;
    *) src=$dir/$src ;;
  esac
done
APP_DIR=$(cd -P "$(dirname "$src")/.." && pwd)

VENV=$APP_DIR/.venv
if [ ! -x "$VENV/bin/assess-lights" ]; then
  echo "assess-lights: no usable virtualenv at $VENV" >&2
  echo "Install it first:  $APP_DIR/install.sh" >&2
  exit 127
fi

# Make sure the venv's own bin dir is first so any sibling tools it ships win,
# then hand over. Nothing else about the caller's environment is modified.
PATH="$VENV/bin:$PATH"
export PATH
exec "$VENV/bin/assess-lights" "$@"
